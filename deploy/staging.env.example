# Copy this file to .env only inside the staging checkout on the VPS.
# Never commit the resulting .env file. Generate every CHANGE_ME value independently.
COMPOSE_PROJECT_NAME=mensah-rentals-staging
NODE_ENV=production
PLATFORM_ENVIRONMENT=STAGING

POSTGRES_USER=mensah_staging
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=mensah_rentals_staging
DATABASE_URL=postgresql://mensah_staging:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/mensah_rentals_staging?schema=public

API_PORT=4000
WEB_ORIGIN=https://staging.mensahrentals.com
SITE_URL=https://staging.mensahrentals.com
SITE_INDEXING_ENABLED=false
ADMIN_ORIGIN=https://admin-staging.mensahrentals.com
API_INTERNAL_URL=http://api:4000
CADDY_WEB_ALIAS=mensah-staging-web
CADDY_ADMIN_ALIAS=mensah-staging-admin
CADDY_API_ALIAS=mensah-staging-api

MEDIA_STORAGE_ROOT=/app/storage/media
REPORTING_TIME_ZONE=Africa/Accra
REPORT_EXPORT_MAX_ROWS=10000
REPORT_EXPORT_MAX_DAYS=366
BACKUP_STATUS_FILE=/app/.backup-status/backup-status.json
APP_VERSION=staging
APP_COMMIT_SHA=
TRUST_PROXY_REQUEST_ID=false

GOOGLE_PLACES_API_KEY=
GOOGLE_BUSINESS_PLACE_ID=
GOOGLE_REVIEWS_URL=
GOOGLE_WRITE_REVIEW_URL=
GOOGLE_REVIEWS_LIVE_ENABLED=false
GOOGLE_PLACES_LANGUAGE_CODE=en-CA
GOOGLE_PLACES_REGION_CODE=CA
GOOGLE_PLACES_TIMEOUT_MS=4000
PUBLIC_GOOGLE_REVIEWS_RATE_LIMIT=120
PUBLIC_GOOGLE_REVIEWS_RATE_WINDOW_SECONDS=60

PUBLIC_CONTACT_RATE_LIMIT=5
PUBLIC_CONTACT_RATE_WINDOW_SECONDS=3600
PUBLIC_CONTACT_GLOBAL_RATE_LIMIT=1000
PUBLIC_CONTACT_GLOBAL_RATE_WINDOW_SECONDS=60

PUBLIC_CART_COOKIE_NAME=__Host-mensah_staging_rental_cart
PUBLIC_CART_TTL_DAYS=30
PUBLIC_CART_COOKIE_SECURE=true
PUBLIC_CART_READ_RATE_LIMIT=300
PUBLIC_CART_READ_RATE_WINDOW_SECONDS=60
PUBLIC_CART_MUTATION_RATE_LIMIT=120
PUBLIC_CART_MUTATION_RATE_WINDOW_SECONDS=60
PUBLIC_CART_GLOBAL_RATE_LIMIT=10000
PUBLIC_CART_GLOBAL_RATE_WINDOW_SECONDS=60

PUBLIC_REQUEST_COOKIE_NAME=__Host-mensah_staging_rental_request
PUBLIC_REQUEST_COOKIE_SECURE=true
PUBLIC_REQUEST_TRACKING_TTL_DAYS=180
PUBLIC_REQUEST_TRACKING_SECRET=CHANGE_ME_RANDOM_REQUEST_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_REQUEST_SUBMIT_RATE_LIMIT=5
PUBLIC_REQUEST_SUBMIT_RATE_WINDOW_SECONDS=3600
PUBLIC_REQUEST_TRACK_RATE_LIMIT=60
PUBLIC_REQUEST_TRACK_RATE_WINDOW_SECONDS=60
PUBLIC_REQUEST_GLOBAL_RATE_LIMIT=10000
PUBLIC_REQUEST_GLOBAL_RATE_WINDOW_SECONDS=60

PUBLIC_QUOTE_ACCESS_SECRET=CHANGE_ME_RANDOM_QUOTE_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_QUOTE_ACCESS_TTL_DAYS=30
PUBLIC_QUOTE_COOKIE_NAME=__Host-mensah_staging_quote_access
PUBLIC_QUOTE_COOKIE_SECURE=true

PUBLIC_ORDER_ACCESS_SECRET=CHANGE_ME_RANDOM_ORDER_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_ORDER_ACCESS_TTL_DAYS=90
PUBLIC_ORDER_COOKIE_NAME=__Host-mensah_staging_order_access
PUBLIC_ORDER_COOKIE_SECURE=true

STAFF_SESSION_COOKIE_NAME=__Host-mensah_staging_staff_session
STAFF_SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=true
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=60

