generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum InventoryTrackingMode {
  BULK
  SERIALIZED
}

enum InventoryState {
  RENTABLE
  RENTED
  MAINTENANCE
  DAMAGED
  LOST
  RETIRED
}

enum InventoryTransactionKind {
  INITIAL_STOCK
  BULK_MOVEMENT
  SERIALIZED_ITEM_CREATED
  SERIALIZED_ITEM_STATE_CHANGED
}

enum RentalRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum RentalRequestActivityType {
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  NOTE_ADDED
  REVIEW_STARTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum RentalRequestDecisionOutcome {
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum RentalRequestFulfillmentMethod {
  PICKUP
  DELIVERY
  DELIVERY_AND_SETUP
}

enum QuoteRevisionState {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum QuoteChargeType {
  DELIVERY
  PICKUP
  SETUP
  TEARDOWN
  LABOUR
  OTHER
}

enum QuoteCustomerResponseKind {
  ACCEPTED
  REJECTED
}

enum QuoteActivityType {
  QUOTE_CREATED
  QUOTE_REVISION_CREATED
  QUOTE_SENT
  QUOTE_VIEWED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  QUOTE_EXPIRED
  QUOTE_SUPERSEDED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus     @default(DISABLED)
  lastLoginAt  DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  sessions     StaffSession[]
  roles        UserRole[]     @relation("UserRoles")
  roleAssignmentsMade UserRole[] @relation("UserRoleAssignedBy")
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactionActor")
  assignedRentalRequests RentalRequest[] @relation("RentalRequestAssignee")
  rentalRequestNotes RentalRequestInternalNote[] @relation("RentalRequestNoteAuthor")
  rentalRequestActivities RentalRequestActivity[] @relation("RentalRequestActivityActor")
  rentalRequestDecisions RentalRequestDecision[] @relation("RentalRequestDecisionActor")
  rentalRequestPreviousAssignments RentalRequestActivity[] @relation("RentalRequestActivityPreviousAssignee")
  rentalRequestNewAssignments RentalRequestActivity[] @relation("RentalRequestActivityNewAssignee")
  quotesCreated Quote[] @relation("QuoteCreator")
  quoteRevisionsCreated QuoteRevision[] @relation("QuoteRevisionCreator")
  quoteRevisionsSent QuoteRevisionLifecycle[] @relation("QuoteRevisionSender")
  quoteActivities QuoteActivity[] @relation("QuoteActivityActor")
}

model StaffSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  displayName String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  roles       RolePermission[]
}

model UserRole {
  userId       String
  roleId       String
  assignedById String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  products    Product[]

  @@index([isActive, sortOrder, name, id])
}

model Product {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  shortDescription String
  description      String?                @db.Text
  rentalUnit       String                 @default("each")
  categoryId       String
  isActive         Boolean                @default(true)
  isFeatured       Boolean                @default(false)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)
  category         Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  specifications   ProductSpecification[]
  inventory        Inventory?
  cartItems        CartItem[]
  rentalRequestItems RentalRequestItem[]

  @@index([categoryId, isActive, name, id])
  @@index([isActive, isFeatured, updatedAt, id])
}

model Cart {
  id        String     @id @default(cuid())
  tokenHash String     @unique @db.Char(64)
  expiresAt DateTime   @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  items     CartItem[]

  @@index([expiresAt, id])
}

model CartItem {
  cartId          String
  productId       String
  desiredQuantity Int
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([cartId, productId])
  @@index([productId])
}

model GuestRequestSession {
  id        String          @id @default(cuid())
  tokenHash String          @unique @db.Char(64)
  expiresAt DateTime        @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  requests  RentalRequest[]

  @@index([expiresAt, id])
}

model RentalRequest {
  id                    String                         @id @default(cuid())
  referenceNumber       String                         @unique
  submissionKeyHash     String                         @unique @db.Char(64)
  submissionPayloadHash String                         @db.Char(64)
  sourceCartTokenHash   String                         @unique @db.Char(64)
  guestSessionId        String?
  assignedToUserId      String?
  status                RentalRequestStatus            @default(SUBMITTED)
  fulfillmentMethod     RentalRequestFulfillmentMethod
  contactFirstName      String
  contactLastName       String
  contactEmail          String
  contactPhone          String
  companyName           String?
  projectName           String
  projectType           String
  projectLocation       String
  deliveryAddress       String?
  rentalStartDate       DateTime                       @db.Date
  rentalEndDate         DateTime                       @db.Date
  requestedTimeZone     String
  customerNotes         String?                        @db.Text
  submittedAt           DateTime                       @default(now()) @db.Timestamptz(3)
  assignedAt            DateTime?                      @db.Timestamptz(3)
  reviewStartedAt       DateTime?                      @db.Timestamptz(3)
  reviewVersion         Int                            @default(0)
  updatedAt             DateTime                       @updatedAt @db.Timestamptz(3)
  guestSession          GuestRequestSession?           @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  assignedTo            User?                          @relation("RentalRequestAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  items                 RentalRequestItem[]
  internalNotes         RentalRequestInternalNote[]
  activities            RentalRequestActivity[]
  decision              RentalRequestDecision?
  quote                 Quote?

  @@index([guestSessionId, submittedAt, id])
  @@index([status, submittedAt, id])
  @@index([assignedToUserId, submittedAt, id])
  @@index([rentalStartDate, submittedAt, id])
  @@index([updatedAt, id])
  @@index([contactEmail, submittedAt])
}

model RentalRequestInternalNote {
  id              String        @id @default(cuid())
  rentalRequestId String
  authorUserId    String
  operationId     String        @unique
  body            String        @db.Text
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  rentalRequest   RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  author          User          @relation("RentalRequestNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  activity        RentalRequestActivity?

  @@index([rentalRequestId, createdAt, id])
  @@index([authorUserId, createdAt, id])
}

model RentalRequestActivity {
  id                       String                    @id @default(cuid())
  rentalRequestId          String
  actorUserId              String?
  type                     RentalRequestActivityType
  previousAssigneeUserId   String?
  newAssigneeUserId        String?
  noteId                   String?                   @unique
  previousStatus           RentalRequestStatus?
  newStatus                RentalRequestStatus?
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  rentalRequest            RentalRequest             @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  actor                    User?                     @relation("RentalRequestActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  previousAssignee         User?                     @relation("RentalRequestActivityPreviousAssignee", fields: [previousAssigneeUserId], references: [id], onDelete: Restrict)
  newAssignee              User?                     @relation("RentalRequestActivityNewAssignee", fields: [newAssigneeUserId], references: [id], onDelete: Restrict)
  note                     RentalRequestInternalNote? @relation(fields: [noteId], references: [id], onDelete: Restrict)
  decisionId               String?                   @unique
  decision                 RentalRequestDecision?    @relation(fields: [decisionId], references: [id], onDelete: Restrict)

  @@index([rentalRequestId, createdAt, id])
  @@index([actorUserId, createdAt, id])
  @@index([previousAssigneeUserId])
  @@index([newAssigneeUserId])
}

model RentalRequestItem {
  id                String        @id @default(cuid())
  rentalRequestId   String
  productId         String
  requestedQuantity Int
  productName       String
  productSlug       String
  categoryName      String
  categorySlug      String
  rentalUnit        String
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  rentalRequest     RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  decisionItem      RentalRequestDecisionItem?

  @@unique([rentalRequestId, productId])
  @@index([productId])
}

model RentalRequestDecision {
  id                  String                       @id @default(cuid())
  rentalRequestId     String                       @unique
  outcome             RentalRequestDecisionOutcome
  decidedByUserId     String
  operationId         String                       @unique
  payloadHash         String                       @db.Char(64)
  internalReason      String                       @db.Text
  customerExplanation String?                      @db.Text
  reviewVersionBefore Int
  reviewVersionAfter  Int
  decidedAt           DateTime                     @default(now()) @db.Timestamptz(3)
  rentalRequest       RentalRequest                @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  decidedBy           User                         @relation("RentalRequestDecisionActor", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  items               RentalRequestDecisionItem[]
  activity            RentalRequestActivity?
  quoteRevisions      QuoteRevision[]

  @@index([decidedByUserId, decidedAt, id])
  @@index([outcome, decidedAt, id])
}

model RentalRequestDecisionItem {
  id                        String                @id @default(cuid())
  decisionId                String
  rentalRequestItemId       String                @unique
  requestedQuantitySnapshot Int
  approvedQuantity          Int
  createdAt                 DateTime              @default(now()) @db.Timestamptz(3)
  decision                  RentalRequestDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  rentalRequestItem         RentalRequestItem     @relation(fields: [rentalRequestItemId], references: [id], onDelete: Restrict)
  quoteItems                QuoteRevisionItem[]

  @@unique([decisionId, rentalRequestItemId])
  @@index([decisionId, createdAt, id])
}

model Quote {
  id                 String          @id @default(cuid())
  rentalRequestId    String          @unique
  quoteNumber        String          @unique
  latestRevisionId   String?         @unique
  customerRevisionId String?         @unique
  createdByUserId    String
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  rentalRequest      RentalRequest   @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  createdBy          User            @relation("QuoteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revisions          QuoteRevision[] @relation("QuoteRevisions")
  latestRevision     QuoteRevision?  @relation("QuoteLatestRevision", fields: [latestRevisionId], references: [id], onDelete: Restrict)
  customerRevision   QuoteRevision?  @relation("QuoteCustomerRevision", fields: [customerRevisionId], references: [id], onDelete: Restrict)
  activities         QuoteActivity[]

  @@index([createdAt, id])
  @@index([createdByUserId, createdAt, id])
}

model QuoteRevision {
  id                      String                  @id @default(cuid())
  quoteId                 String
  revisionNumber          Int
  rentalRequestDecisionId String
  currency                String                  @default("CAD") @db.Char(3)
  itemSubtotalCents       BigInt
  chargeTotalCents        BigInt
  subtotalCents           BigInt
  discountCents           BigInt
  discountTaxable         Boolean                 @default(true)
  taxableSubtotalCents    BigInt
  taxCents                BigInt
  totalCents              BigInt
  customerNotes           String?                 @db.Text
  internalNotes           String?                 @db.Text
  terms                   String?                 @db.Text
  validUntil              DateTime                @db.Timestamptz(3)
  createdByUserId         String
  operationId             String                  @unique
  payloadHash             String                  @db.Char(64)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  quote                   Quote                   @relation("QuoteRevisions", fields: [quoteId], references: [id], onDelete: Restrict)
  decision                RentalRequestDecision   @relation(fields: [rentalRequestDecisionId], references: [id], onDelete: Restrict)
  createdBy               User                    @relation("QuoteRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  latestForQuote          Quote?                  @relation("QuoteLatestRevision")
  customerForQuote        Quote?                  @relation("QuoteCustomerRevision")
  items                   QuoteRevisionItem[]
  charges                 QuoteRevisionCharge[]
  tax                     QuoteRevisionTax?
  lifecycle               QuoteRevisionLifecycle?
  customerAccess          QuoteCustomerAccess?
  customerResponse        QuoteCustomerResponse?
  activities              QuoteActivity[]

  @@unique([quoteId, revisionNumber])
  @@index([rentalRequestDecisionId, createdAt, id])
  @@index([validUntil, id])
  @@index([totalCents, id])
}

model QuoteRevisionItem {
  id                        String                    @id @default(cuid())
  quoteRevisionId           String
  rentalRequestDecisionItemId String
  productIdSnapshot         String
  productNameSnapshot       String
  productSlugSnapshot       String
  categoryNameSnapshot      String
  categorySlugSnapshot      String
  rentalUnitSnapshot        String
  approvedQuantitySnapshot Int
  quotedQuantity            Int
  unitPriceCents            BigInt
  lineSubtotalCents         BigInt
  taxable                   Boolean                   @default(true)
  sortOrder                 Int
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  quoteRevision             QuoteRevision             @relation(fields: [quoteRevisionId], references: [id], onDelete: Restrict)
  decisionItem              RentalRequestDecisionItem @relation(fields: [rentalRequestDecisionItemId], references: [id], onDelete: Restrict)

  @@unique([quoteRevisionId, rentalRequestDecisionItemId])
  @@unique([quoteRevisionId, sortOrder])
  @@index([rentalRequestDecisionItemId])
}

model QuoteRevisionCharge {
  id              String          @id @default(cuid())
  quoteRevisionId String
  type            QuoteChargeType
  label           String
  amountCents     BigInt
  taxable         Boolean         @default(true)
  sortOrder       Int
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  quoteRevision   QuoteRevision   @relation(fields: [quoteRevisionId], references: [id], onDelete: Restrict)

  @@unique([quoteRevisionId, sortOrder])
}

model QuoteRevisionTax {
  id                   String        @id @default(cuid())
  quoteRevisionId      String        @unique
  name                 String
  rateBasisPoints      Int
  taxableAmountCents   BigInt
  taxAmountCents       BigInt
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  quoteRevision        QuoteRevision @relation(fields: [quoteRevisionId], references: [id], onDelete: Restrict)
}

model QuoteRevisionLifecycle {
  quoteRevisionId String             @id
  state           QuoteRevisionState @default(DRAFT)
  lifecycleVersion Int               @default(0)
  sentAt          DateTime?          @db.Timestamptz(3)
  sentByUserId    String?
  viewedAt        DateTime?          @db.Timestamptz(3)
  terminalAt      DateTime?          @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)
  quoteRevision   QuoteRevision      @relation(fields: [quoteRevisionId], references: [id], onDelete: Restrict)
  sentBy          User?              @relation("QuoteRevisionSender", fields: [sentByUserId], references: [id], onDelete: Restrict)

  @@index([state, updatedAt, quoteRevisionId])
}

model QuoteCustomerAccess {
  id              String        @id @default(uuid()) @db.Uuid
  quoteRevisionId String        @unique
  tokenHash       String        @unique @db.Char(64)
  expiresAt       DateTime      @db.Timestamptz(3)
  revokedAt       DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  quoteRevision   QuoteRevision @relation(fields: [quoteRevisionId], references: [id], onDelete: Restrict)

  @@index([expiresAt, id])
}

model QuoteCustomerResponse {
  id              String                    @id @default(cuid())
  quoteRevisionId String                    @unique
  response        QuoteCustomerResponseKind
  operationId     String                    @unique
  payloadHash     String                    @db.Char(64)
  note            String?                   @db.Text
  respondedAt     DateTime                  @default(now()) @db.Timestamptz(3)
  quoteRevision   QuoteRevision             @relation(fields: [quoteRevisionId], references: [id], onDelete: Restrict)
}

model QuoteActivity {
  id              String            @id @default(cuid())
  quoteId         String
  quoteRevisionId String
  actorUserId     String?
  type            QuoteActivityType
  operationId     String?           @unique
  payloadHash     String?           @db.Char(64)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  quote           Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  quoteRevision   QuoteRevision     @relation(fields: [quoteRevisionId], references: [id], onDelete: Restrict)
  actor           User?             @relation("QuoteActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([quoteId, createdAt, id])
  @@index([quoteRevisionId, createdAt, id])
}

model Inventory {
  id                  String                @id @default(cuid())
  productId           String                @unique
  creationOperationId String                @unique
  creationReason      String
  initialState        InventoryState
  trackingMode        InventoryTrackingMode
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  items               InventoryItem[]
  transactions        InventoryTransaction[]

  @@index([trackingMode, id])
}

model InventoryItem {
  id           String         @id @default(cuid())
  inventoryId  String
  assetNumber  String         @unique
  serialNumber String?
  status       InventoryState @default(RENTABLE)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  inventory    Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  transactions InventoryTransaction[]

  @@index([inventoryId, status, id])
  @@index([serialNumber])
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  inventoryId     String
  inventoryItemId String?
  kind            InventoryTransactionKind
  quantity        Int
  fromState       InventoryState?
  toState         InventoryState?
  operationId     String                   @unique
  reason          String
  actorUserId     String
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  inventory       Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  inventoryItem   InventoryItem?           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  actor           User                     @relation("InventoryTransactionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([inventoryId, createdAt, id])
  @@index([inventoryItemId, createdAt, id])
  @@index([actorUserId, createdAt, id])
  @@index([inventoryId, fromState])
  @@index([inventoryId, toState])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String   @db.Text
  altText   String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, sortOrder, id])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, sortOrder, id])
}
