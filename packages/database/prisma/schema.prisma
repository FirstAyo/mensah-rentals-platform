generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum InventoryTrackingMode {
  BULK
  SERIALIZED
}

enum InventoryState {
  RENTABLE
  RENTED
  MAINTENANCE
  DAMAGED
  LOST
  RETIRED
}

enum InventoryTransactionKind {
  INITIAL_STOCK
  BULK_MOVEMENT
  SERIALIZED_ITEM_CREATED
  SERIALIZED_ITEM_STATE_CHANGED
}

enum RentalRequestStatus {
  SUBMITTED
  RE_REVIEW_REQUIRED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum RentalRequestActivityType {
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  NOTE_ADDED
  REVIEW_STARTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  AMENDMENT_SUBMITTED
  RE_REVIEW_STARTED
  DECISION_SUPERSEDED
  QUOTE_SUPERSEDED
  QUOTE_ACCESS_REVOKED
  CHANGE_REQUEST_SUBMITTED
  CHANGE_REQUEST_REVIEWED
}

enum RentalRequestRevisionSubmitterType {
  ORIGINAL_SUBMISSION
  CUSTOMER
  STAFF
}

enum RentalChangeRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED_FOR_REQUOTE
  REJECTED
  WITHDRAWN
  SUPERSEDED
}

enum RentalChangeRequestItemType {
  ADDED
  REMOVED
  QUANTITY_CHANGED
  UNCHANGED
}

enum RentalRequestDecisionOutcome {
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum RentalRequestFulfillmentMethod {
  PICKUP
  DELIVERY
  DELIVERY_AND_SETUP
}

enum QuoteRevisionState {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum QuoteChargeType {
  DELIVERY
  PICKUP
  SETUP
  TEARDOWN
  LABOUR
  OTHER
}

enum QuoteDiscountType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum QuoteCustomerResponseKind {
  ACCEPTED
  REJECTED
}

enum QuoteActivityType {
  QUOTE_CREATED
  QUOTE_REVISION_CREATED
  QUOTE_SENT
  QUOTE_VIEWED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  QUOTE_EXPIRED
  QUOTE_SUPERSEDED
  QUOTE_DRAFT_UPDATED
  QUOTE_RESENT
  QUOTE_ACCESS_ROTATED
}

enum RentalOrderStatus {
  CONFIRMED
}

enum RentalOrderReservationStatus {
  NOT_RESERVED
  PARTIALLY_RESERVED
  RESERVED
  RESERVATION_FAILED
  RELEASED
  PARTIALLY_CONSUMED
  CONSUMED
}

enum InventoryReservationStatus {
  PENDING
  PARTIALLY_RESERVED
  RESERVED
  RESERVATION_FAILED
  RELEASED
  PARTIALLY_CONSUMED
  CONSUMED
}

enum InventoryReservationItemType {
  BULK
  SERIALIZED
}

enum InventoryReservationOperationType {
  RESERVATION_CREATED
  RESERVATION_PARTIALLY_CREATED
  RESERVATION_COMPLETED
  RESERVATION_QUANTITY_ADDED
  SERIALIZED_ASSET_ALLOCATED
  SERIALIZED_ASSET_RELEASED
  RESERVATION_QUANTITY_RELEASED
  RESERVATION_RELEASED
  RESERVATION_FAILED
  RESERVATION_OVERRIDE_RECORDED
}

enum SerializedAssetAllocationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum OrderFulfilmentStatus {
  PREPARING
  READY
  PARTIALLY_CHECKED_OUT
  CHECKED_OUT
}

enum FulfilmentOperationType {
  PREPARATION_STARTED
  PREPARATION_UPDATED
  MARKED_READY
  CHECKOUT
}

enum ActiveRentalStatus {
  PARTIALLY_ACTIVE
  ACTIVE
}

enum FulfilmentHandoffType {
  PICKUP
  DELIVERY
}

enum RentalOrderActivityType {
  ORDER_CREATED
  ORDER_CUSTOMER_ACCESS_CREATED
  ORDER_VIEWED
  ORDER_CUSTOMER_ACCESS_REVOKED
  ORDER_CUSTOMER_ACCESS_ROTATED
  ORDER_CUSTOMER_ACCESS_RESENT
}

model User {
  id                               String                          @id @default(cuid())
  email                            String                          @unique
  passwordHash                     String
  firstName                        String
  lastName                         String
  status                           UserStatus                      @default(DISABLED)
  lastLoginAt                      DateTime?                       @db.Timestamptz(3)
  createdAt                        DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                        DateTime                        @updatedAt @db.Timestamptz(3)
  sessions                         StaffSession[]
  roles                            UserRole[]                      @relation("UserRoles")
  roleAssignmentsMade              UserRole[]                      @relation("UserRoleAssignedBy")
  inventoryTransactions            InventoryTransaction[]          @relation("InventoryTransactionActor")
  assignedRentalRequests           RentalRequest[]                 @relation("RentalRequestAssignee")
  rentalRequestNotes               RentalRequestInternalNote[]     @relation("RentalRequestNoteAuthor")
  rentalRequestActivities          RentalRequestActivity[]         @relation("RentalRequestActivityActor")
  rentalRequestDecisions           RentalRequestDecision[]         @relation("RentalRequestDecisionActor")
  rentalRequestPreviousAssignments RentalRequestActivity[]         @relation("RentalRequestActivityPreviousAssignee")
  rentalRequestNewAssignments      RentalRequestActivity[]         @relation("RentalRequestActivityNewAssignee")
  quotesCreated                    Quote[]                         @relation("QuoteCreator")
  quoteRevisionsCreated            QuoteRevision[]                 @relation("QuoteRevisionCreator")
  quoteRevisionsSent               QuoteRevisionLifecycle[]        @relation("QuoteRevisionSender")
  quoteActivities                  QuoteActivity[]                 @relation("QuoteActivityActor")
  quoteAccessCreated               QuoteCustomerAccess[]           @relation("QuoteAccessCreator")
  rentalOrdersConfirmed            RentalOrder[]                   @relation("RentalOrderConfirmer")
  rentalOrderActivities            RentalOrderActivity[]           @relation("RentalOrderActivityActor")
  orderAccessCreated               OrderCustomerAccess[]           @relation("OrderAccessCreator")
  inventoryReservationsCreated     InventoryReservation[]          @relation("InventoryReservationCreator")
  inventoryReservationOperations   InventoryReservationOperation[] @relation("InventoryReservationOperationActor")
  serializedAllocationsCreated     SerializedAssetAllocation[]     @relation("SerializedAssetAllocationCreator")
  serializedAllocationsReleased    SerializedAssetAllocation[]     @relation("SerializedAssetAllocationReleaser")
  rentalRequestRevisionsCreated    RentalRequestRevision[]         @relation("RentalRequestRevisionStaffCreator")
  rentalChangeRequestsReviewed     RentalChangeRequest[]           @relation("RentalChangeRequestReviewer")
  fulfilmentsCreated               OrderFulfilment[]               @relation("OrderFulfilmentCreator")
  fulfilmentsUpdated               OrderFulfilment[]               @relation("OrderFulfilmentUpdater")
  fulfilmentOperations             FulfilmentOperation[]           @relation("FulfilmentOperationActor")
  activeRentalsActivated           ActiveRental[]                  @relation("ActiveRentalActivator")
  fulfilmentHandoffs               FulfilmentHandoff[]             @relation("FulfilmentHandoffActor")
}

model StaffSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  displayName String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  roles       RolePermission[]
}

model UserRole {
  userId       String
  roleId       String
  assignedById String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  products    Product[]

  @@index([isActive, sortOrder, name, id])
}

model Product {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  shortDescription           String
  description                String?                     @db.Text
  rentalUnit                 String                      @default("each")
  categoryId                 String
  isActive                   Boolean                     @default(true)
  isFeatured                 Boolean                     @default(false)
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(3)
  category                   Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                     ProductImage[]
  specifications             ProductSpecification[]
  inventory                  Inventory?
  cartItems                  CartItem[]
  rentalRequestItems         RentalRequestItem[]
  rentalRequestRevisionItems RentalRequestRevisionItem[]
  rentalChangeRequestItems   RentalChangeRequestItem[]

  @@index([categoryId, isActive, name, id])
  @@index([isActive, isFeatured, updatedAt, id])
}

model Cart {
  id        String     @id @default(cuid())
  tokenHash String     @unique @db.Char(64)
  expiresAt DateTime   @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  items     CartItem[]

  @@index([expiresAt, id])
}

model CartItem {
  cartId          String
  productId       String
  desiredQuantity Int
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([cartId, productId])
  @@index([productId])
}

model GuestRequestSession {
  id        String          @id @default(cuid())
  tokenHash String          @unique @db.Char(64)
  expiresAt DateTime        @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  requests  RentalRequest[]

  @@index([expiresAt, id])
}

model RentalRequestCustomerAccess {
  id              String                   @id @default(cuid())
  rentalRequestId String
  tokenHash       String                   @db.Char(64)
  expiresAt       DateTime                 @db.Timestamptz(3)
  revokedAt       DateTime?                @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  lastUsedAt      DateTime?                @db.Timestamptz(3)
  rentalRequest   RentalRequest            @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  revisions       RentalRequestRevision[]
  amendments      RentalRequestAmendment[]
  changeRequests  RentalChangeRequest[]

  @@unique([rentalRequestId, tokenHash])
  @@index([tokenHash, expiresAt, id])
  @@index([rentalRequestId, expiresAt, id])
}

model RentalRequest {
  id                    String                         @id @default(cuid())
  referenceNumber       String                         @unique
  submissionKeyHash     String                         @unique @db.Char(64)
  submissionPayloadHash String                         @db.Char(64)
  sourceCartTokenHash   String                         @unique @db.Char(64)
  guestSessionId        String?
  assignedToUserId      String?
  status                RentalRequestStatus            @default(SUBMITTED)
  fulfillmentMethod     RentalRequestFulfillmentMethod
  contactFirstName      String
  contactLastName       String
  contactEmail          String
  contactPhone          String
  companyName           String?
  projectName           String
  projectType           String
  projectLocation       String
  deliveryAddress       String?
  rentalStartDate       DateTime                       @db.Date
  rentalEndDate         DateTime                       @db.Date
  requestedTimeZone     String
  customerNotes         String?                        @db.Text
  submittedAt           DateTime                       @default(now()) @db.Timestamptz(3)
  assignedAt            DateTime?                      @db.Timestamptz(3)
  reviewStartedAt       DateTime?                      @db.Timestamptz(3)
  reviewVersion         Int                            @default(0)
  currentRevisionId     String?                        @unique
  updatedAt             DateTime                       @updatedAt @db.Timestamptz(3)
  guestSession          GuestRequestSession?           @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  assignedTo            User?                          @relation("RentalRequestAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  items                 RentalRequestItem[]
  internalNotes         RentalRequestInternalNote[]
  activities            RentalRequestActivity[]
  currentRevision       RentalRequestRevision?         @relation("RentalRequestCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  revisions             RentalRequestRevision[]        @relation("RentalRequestRevisions")
  customerAccess        RentalRequestCustomerAccess[]
  amendments            RentalRequestAmendment[]
  decisions             RentalRequestDecision[]
  quote                 Quote?
  rentalOrder           RentalOrder?
  changeRequests        RentalChangeRequest[]

  @@index([guestSessionId, submittedAt, id])
  @@index([status, submittedAt, id])
  @@index([assignedToUserId, submittedAt, id])
  @@index([rentalStartDate, submittedAt, id])
  @@index([updatedAt, id])
  @@index([contactEmail, submittedAt])
}

model RentalRequestRevision {
  id                          String                             @id @default(cuid())
  rentalRequestId             String
  revisionNumber              Int
  submittedByType             RentalRequestRevisionSubmitterType
  submittedByCustomerAccessId String?
  createdByStaffUserId        String?
  amendmentReason             String?                            @db.Text
  contactFirstName            String
  contactLastName             String
  contactEmail                String
  contactPhone                String
  companyName                 String?
  projectName                 String
  projectType                 String
  projectLocation             String
  fulfillmentMethod           RentalRequestFulfillmentMethod
  deliveryAddress             String?                            @db.Text
  rentalStartDate             DateTime                           @db.Date
  rentalEndDate               DateTime                           @db.Date
  requestedTimeZone           String
  customerNotes               String?                            @db.Text
  operationId                 String                             @unique
  payloadHash                 String                             @db.Char(64)
  createdAt                   DateTime                           @default(now()) @db.Timestamptz(3)
  rentalRequest               RentalRequest                      @relation("RentalRequestRevisions", fields: [rentalRequestId], references: [id], onDelete: Restrict)
  currentForRequest           RentalRequest?                     @relation("RentalRequestCurrentRevision")
  submittedByCustomerAccess   RentalRequestCustomerAccess?       @relation(fields: [submittedByCustomerAccessId], references: [id], onDelete: Restrict)
  createdByStaff              User?                              @relation("RentalRequestRevisionStaffCreator", fields: [createdByStaffUserId], references: [id], onDelete: Restrict)
  items                       RentalRequestRevisionItem[]
  amendmentFromBase           RentalRequestAmendment?            @relation("RentalRequestAmendmentNewRevision")
  amendmentsBasedOn           RentalRequestAmendment[]           @relation("RentalRequestAmendmentBaseRevision")
  decision                    RentalRequestDecision?
  supersededDecisions         RentalRequestDecision[]            @relation("RentalRequestDecisionSupersededByRevision")
  activities                  RentalRequestActivity[]
  changeRequests              RentalChangeRequest[]

  @@unique([rentalRequestId, revisionNumber])
  @@index([rentalRequestId, createdAt, id])
  @@index([submittedByCustomerAccessId, createdAt, id])
  @@index([createdByStaffUserId, createdAt, id])
}

model RentalRequestRevisionItem {
  id                      String                     @id @default(cuid())
  rentalRequestRevisionId String
  productId               String?
  productNameSnapshot     String
  productSlugSnapshot     String
  categoryNameSnapshot    String
  categorySlugSnapshot    String
  rentalUnitSnapshot      String
  primaryImageUrlSnapshot String?
  requestedQuantity       Int
  sortOrder               Int
  createdAt               DateTime                   @default(now()) @db.Timestamptz(3)
  revision                RentalRequestRevision      @relation(fields: [rentalRequestRevisionId], references: [id], onDelete: Restrict)
  product                 Product?                   @relation(fields: [productId], references: [id], onDelete: SetNull)
  decisionItem            RentalRequestDecisionItem?

  @@unique([rentalRequestRevisionId, productId])
  @@unique([rentalRequestRevisionId, productSlugSnapshot])
  @@unique([rentalRequestRevisionId, sortOrder])
  @@index([productId])
}

model RentalRequestAmendment {
  id                          String                      @id @default(cuid())
  rentalRequestId             String
  baseRevisionId              String
  newRevisionId               String                      @unique
  submittedByCustomerAccessId String
  operationId                 String                      @unique
  payloadHash                 String                      @db.Char(64)
  submittedAt                 DateTime                    @default(now()) @db.Timestamptz(3)
  rentalRequest               RentalRequest               @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  baseRevision                RentalRequestRevision       @relation("RentalRequestAmendmentBaseRevision", fields: [baseRevisionId], references: [id], onDelete: Restrict)
  newRevision                 RentalRequestRevision       @relation("RentalRequestAmendmentNewRevision", fields: [newRevisionId], references: [id], onDelete: Restrict)
  submittedByCustomerAccess   RentalRequestCustomerAccess @relation(fields: [submittedByCustomerAccessId], references: [id], onDelete: Restrict)

  @@unique([rentalRequestId, baseRevisionId])
  @@index([rentalRequestId, submittedAt, id])
  @@index([submittedByCustomerAccessId, submittedAt, id])
}

model RentalRequestInternalNote {
  id              String                 @id @default(cuid())
  rentalRequestId String
  authorUserId    String
  operationId     String                 @unique
  body            String                 @db.Text
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  rentalRequest   RentalRequest          @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  author          User                   @relation("RentalRequestNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  activity        RentalRequestActivity?

  @@index([rentalRequestId, createdAt, id])
  @@index([authorUserId, createdAt, id])
}

model RentalRequestActivity {
  id                     String                     @id @default(cuid())
  rentalRequestId        String
  actorUserId            String?
  type                   RentalRequestActivityType
  previousAssigneeUserId String?
  newAssigneeUserId      String?
  noteId                 String?                    @unique
  previousStatus         RentalRequestStatus?
  newStatus              RentalRequestStatus?
  createdAt              DateTime                   @default(now()) @db.Timestamptz(3)
  rentalRequest          RentalRequest              @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  actor                  User?                      @relation("RentalRequestActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  previousAssignee       User?                      @relation("RentalRequestActivityPreviousAssignee", fields: [previousAssigneeUserId], references: [id], onDelete: Restrict)
  newAssignee            User?                      @relation("RentalRequestActivityNewAssignee", fields: [newAssigneeUserId], references: [id], onDelete: Restrict)
  note                   RentalRequestInternalNote? @relation(fields: [noteId], references: [id], onDelete: Restrict)
  decisionId             String?                    @unique
  revisionId             String?
  decision               RentalRequestDecision?     @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  revision               RentalRequestRevision?     @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@index([rentalRequestId, createdAt, id])
  @@index([actorUserId, createdAt, id])
  @@index([previousAssigneeUserId])
  @@index([newAssigneeUserId])
  @@index([revisionId, createdAt, id])
}

model RentalRequestItem {
  id                String        @id @default(cuid())
  rentalRequestId   String
  productId         String
  requestedQuantity Int
  productName       String
  productSlug       String
  categoryName      String
  categorySlug      String
  rentalUnit        String
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  rentalRequest     RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([rentalRequestId, productId])
  @@index([productId])
}

model RentalRequestDecision {
  id                      String                       @id @default(cuid())
  rentalRequestId         String
  rentalRequestRevisionId String                       @unique
  outcome                 RentalRequestDecisionOutcome
  decidedByUserId         String
  operationId             String                       @unique
  payloadHash             String                       @db.Char(64)
  internalReason          String                       @db.Text
  customerExplanation     String?                      @db.Text
  reviewVersionBefore     Int
  reviewVersionAfter      Int
  supersededAt            DateTime?                    @db.Timestamptz(3)
  supersededByRevisionId  String?
  decidedAt               DateTime                     @default(now()) @db.Timestamptz(3)
  rentalRequest           RentalRequest                @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  rentalRequestRevision   RentalRequestRevision        @relation(fields: [rentalRequestRevisionId], references: [id], onDelete: Restrict)
  supersededByRevision    RentalRequestRevision?       @relation("RentalRequestDecisionSupersededByRevision", fields: [supersededByRevisionId], references: [id], onDelete: Restrict)
  decidedBy               User                         @relation("RentalRequestDecisionActor", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  items                   RentalRequestDecisionItem[]
  activity                RentalRequestActivity?
  quoteRevisions          QuoteRevision[]
  rentalOrder             RentalOrder?

  @@index([decidedByUserId, decidedAt, id])
  @@index([outcome, decidedAt, id])
  @@index([rentalRequestId, decidedAt, id])
  @@index([supersededByRevisionId])
}

model RentalRequestDecisionItem {
  id                          String                    @id @default(cuid())
  decisionId                  String
  rentalRequestRevisionItemId String                    @unique
  requestedQuantitySnapshot   Int
  approvedQuantity            Int
  createdAt                   DateTime                  @default(now()) @db.Timestamptz(3)
  decision                    RentalRequestDecision     @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  rentalRequestRevisionItem   RentalRequestRevisionItem @relation(fields: [rentalRequestRevisionItemId], references: [id], onDelete: Restrict)
  quoteItems                  QuoteRevisionItem[]

  @@unique([decisionId, rentalRequestRevisionItemId])
  @@index([decisionId, createdAt, id])
}

model Quote {
  id                 String                @id @default(cuid())
  rentalRequestId    String                @unique
  quoteNumber        String                @unique
  latestRevisionId   String?               @unique
  customerRevisionId String?               @unique
  createdByUserId    String
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  rentalRequest      RentalRequest         @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
  createdBy          User                  @relation("QuoteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revisions          QuoteRevision[]       @relation("QuoteRevisions")
  latestRevision     QuoteRevision?        @relation("QuoteLatestRevision", fields: [latestRevisionId], references: [id], onDelete: Restrict)
  customerRevision   QuoteRevision?        @relation("QuoteCustomerRevision", fields: [customerRevisionId], references: [id], onDelete: Restrict)
  activities         QuoteActivity[]
  rentalOrder        RentalOrder?
  changeRequests     RentalChangeRequest[]

  @@index([createdAt, id])
  @@index([createdByUserId, createdAt, id])
}

model QuoteRevision {
  id                        String                         @id @default(cuid())
  quoteId                   String
  revisionNumber            Int
  rentalRequestDecisionId   String
  currency                  String                         @default("CAD") @db.Char(3)
  itemSubtotalCents         BigInt
  chargeTotalCents          BigInt
  subtotalCents             BigInt
  discountCents             BigInt
  discountTaxable           Boolean                        @default(true)
  discountType              QuoteDiscountType              @default(FIXED_AMOUNT)
  discountRateBasisPoints   Int?
  discountBaseCents         BigInt
  taxableDiscountCents      BigInt
  taxableSubtotalCents      BigInt
  taxCents                  BigInt
  totalCents                BigInt
  customerNotes             String?                        @db.Text
  internalNotes             String?                        @db.Text
  terms                     String?                        @db.Text
  validUntil                DateTime                       @db.Timestamptz(3)
  contactFirstNameSnapshot  String
  contactLastNameSnapshot   String
  companyNameSnapshot       String?
  projectNameSnapshot       String
  projectTypeSnapshot       String
  projectLocationSnapshot   String
  fulfillmentMethodSnapshot RentalRequestFulfillmentMethod
  deliveryAddressSnapshot   String?                        @db.Text
  rentalStartDateSnapshot   DateTime                       @db.Date
  rentalEndDateSnapshot     DateTime                       @db.Date
  requestedTimeZoneSnapshot String
  createdByUserId           String
  operationId               String                         @unique
  payloadHash               String                         @db.Char(64)
  createdAt                 DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                       @updatedAt @db.Timestamptz(3)
  draftVersion              Int                            @default(0)
