  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  workOrder             MaintenanceWorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  inspection            EquipmentInspection?     @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  actor                 User                     @relation("MaintenanceOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  inventoryTransactions InventoryTransaction[]
  note                  MaintenanceNote?

  @@index([workOrderId, createdAt, id])
  @@index([inspectionId, createdAt, id])
  @@index([actorUserId, createdAt, id])
}

model MaintenanceNote {
  id           String               @id @default(cuid())
  workOrderId  String
  operationId  String               @unique
  authorUserId String
  body         String               @db.Text
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  workOrder    MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  operation    MaintenanceOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  author       User                 @relation("MaintenanceNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([workOrderId, createdAt, id])
  @@index([authorUserId, createdAt, id])
}

model FulfilmentHandoff {
  id                       String                @id @default(cuid())
  activeRentalId           String
  fulfilmentOperationId    String                @unique
  type                     FulfilmentHandoffType
  recipientName            String?
  destinationSnapshot      String?               @db.Text
  acknowledgementReference String?
  internalNotes            String?               @db.Text
  actorUserId              String
  handoffAt                DateTime              @db.Timestamptz(3)
  createdAt                DateTime              @default(now()) @db.Timestamptz(3)
  activeRental             ActiveRental          @relation(fields: [activeRentalId], references: [id], onDelete: Restrict)
  fulfilmentOperation      FulfilmentOperation   @relation(fields: [fulfilmentOperationId], references: [id], onDelete: Restrict)
  actor                    User                  @relation("FulfilmentHandoffActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([activeRentalId, handoffAt, id])
  @@index([actorUserId, handoffAt, id])
}

model ProductImage {
  id                        String                     @id @default(cuid())
  productId                 String
  url                       String                     @db.Text
  altText                   String
  sortOrder                 Int                        @default(0)
  isPrimary                 Boolean                    @default(false)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  product                   Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  homepagePlacements        HomepageMediaPlacement[]   @relation("HomepagePlacementProductImage")
  homepageCategoryOverrides HomepageFeaturedCategory[] @relation("HomepageCategoryOverrideProductImage")
  categoryCovers            CategoryCover[]            @relation("CategoryCoverProductImage")

  @@unique([productId, sortOrder])
  @@index([productId, sortOrder, id])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, sortOrder, id])
}

model HomepageSite {
  id                  String             @id
  draftRevisionId     String?            @unique
  publishedRevisionId String?            @unique
  lockVersion         Int                @default(0)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  revisions           HomepageRevision[] @relation("HomepageRevisions")
  draftRevision       HomepageRevision?  @relation("HomepageDraftHead", fields: [draftRevisionId], references: [id], onDelete: Restrict)
  publishedRevision   HomepageRevision?  @relation("HomepagePublishedHead", fields: [publishedRevisionId], references: [id], onDelete: Restrict)
  activities          HomepageActivity[]
}

model HomepageRevision {
  id                     String                     @id @default(cuid())
  homepageId             String
  version                Int
  kind                   HomepageRevisionKind
  content                Json
  basedOnRevisionId      String?
  restoredFromRevisionId String?
  operationId            String?                    @unique
  payloadHash            String?                    @db.Char(64)
  createdByUserId        String
  publishedByUserId      String?
  createdAt              DateTime                   @default(now()) @db.Timestamptz(3)
  publishedAt            DateTime?                  @db.Timestamptz(3)
  homepage               HomepageSite               @relation("HomepageRevisions", fields: [homepageId], references: [id], onDelete: Restrict)
  basedOnRevision        HomepageRevision?          @relation("HomepageRevisionBasis", fields: [basedOnRevisionId], references: [id], onDelete: Restrict)
  basedRevisions         HomepageRevision[]         @relation("HomepageRevisionBasis")
  restoredFromRevision   HomepageRevision?          @relation("HomepageRevisionRestore", fields: [restoredFromRevisionId], references: [id], onDelete: Restrict)
  restoredRevisions      HomepageRevision[]         @relation("HomepageRevisionRestore")
  createdBy              User                       @relation("HomepageRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy            User?                      @relation("HomepageRevisionPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  draftHeadOf            HomepageSite?              @relation("HomepageDraftHead")
  publishedHeadOf        HomepageSite?              @relation("HomepagePublishedHead")
  featuredCategories     HomepageFeaturedCategory[]
  featuredProducts       HomepageFeaturedProduct[]
  mediaPlacements        HomepageMediaPlacement[]
  activities             HomepageActivity[]

  @@unique([homepageId, version])
  @@index([homepageId, kind, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([publishedByUserId, publishedAt])
}

model HomepageFeaturedCategory {
  revisionId           String
  categoryId           String
  sortOrder            Int
  coverHomepageMediaId String?
  coverProductImageId  String?
  coverAltText         String?          @db.VarChar(300)
  coverFocalPoint      String?          @db.VarChar(20)
  revision             HomepageRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  category             Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverHomepageMedia   HomepageMedia?   @relation("HomepageCategoryOverrideMedia", fields: [coverHomepageMediaId], references: [id], onDelete: Restrict)
  coverProductImage    ProductImage?    @relation("HomepageCategoryOverrideProductImage", fields: [coverProductImageId], references: [id], onDelete: Restrict)

  @@id([revisionId, categoryId])
  @@unique([revisionId, sortOrder])
  @@index([categoryId])
  @@index([coverHomepageMediaId])
  @@index([coverProductImageId])
}

model HomepageFeaturedProduct {
  revisionId String
  productId  String
  sortOrder  Int
  revision   HomepageRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  product    Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([revisionId, productId])
  @@unique([revisionId, sortOrder])
  @@index([productId])
}

model HomepageMedia {
  id                        String                     @id @default(cuid())
  contentHash               String                     @unique @db.Char(64)
  url                       String                     @db.Text
  width                     Int
  height                    Int
  byteSize                  Int
  format                    String
  description               String
  originalFilename          String
  createdByUserId           String
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  createdBy                 User                       @relation("HomepageMediaCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  placements                HomepageMediaPlacement[]
  homepageCategoryOverrides HomepageFeaturedCategory[] @relation("HomepageCategoryOverrideMedia")
  categoryCovers            CategoryCover[]            @relation("CategoryCoverHomepageMedia")

  @@index([createdByUserId, createdAt])
}

model HomepageMediaPlacement {
  revisionId     String
  mediaId        String?
  productImageId String?
  slotKey        String
  sortOrder      Int              @default(0)
  revision       HomepageRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  media          HomepageMedia?   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  productImage   ProductImage?    @relation("HomepagePlacementProductImage", fields: [productImageId], references: [id], onDelete: Restrict)

  @@id([revisionId, slotKey])
  @@index([mediaId])
  @@index([productImageId])
}

model CategoryCover {
  categoryId      String         @id
  homepageMediaId String?
  productImageId  String?
  altText         String         @db.VarChar(300)
  focalPoint      String         @default("center") @db.VarChar(20)
  updatedByUserId String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  homepageMedia   HomepageMedia? @relation("CategoryCoverHomepageMedia", fields: [homepageMediaId], references: [id], onDelete: Restrict)
  productImage    ProductImage?  @relation("CategoryCoverProductImage", fields: [productImageId], references: [id], onDelete: Restrict)
  updatedBy       User           @relation("CategoryCoverUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([homepageMediaId])
  @@index([productImageId])
  @@index([updatedByUserId, updatedAt])
}

model HomepageActivity {
  id          String               @id @default(cuid())
  homepageId  String
  revisionId  String?
  actorUserId String
  type        HomepageActivityType
  details     Json?
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  homepage    HomepageSite         @relation(fields: [homepageId], references: [id], onDelete: Restrict)
  revision    HomepageRevision?    @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  actor       User                 @relation("HomepageActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([homepageId, createdAt, id])
  @@index([revisionId, createdAt])
  @@index([actorUserId, createdAt])
}
