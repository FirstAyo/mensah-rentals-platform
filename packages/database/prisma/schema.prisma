  orderFulfilmentItemId  String
  serializedAllocationId String                    @unique
  createdAt              DateTime                  @default(now()) @db.Timestamptz(3)
  orderFulfilmentItem    OrderFulfilmentItem       @relation(fields: [orderFulfilmentItemId], references: [id], onDelete: Restrict)
  serializedAllocation   SerializedAssetAllocation @relation(fields: [serializedAllocationId], references: [id], onDelete: Restrict)

  @@unique([orderFulfilmentItemId, serializedAllocationId])
  @@index([orderFulfilmentItemId, id])
}

model FulfilmentOperation {
  id                    String                      @id @default(cuid())
  orderFulfilmentId     String
  type                  FulfilmentOperationType
  operationId           String                      @unique @db.Uuid
  payloadHash           String                      @db.Char(64)
  actorUserId           String
  internalReason        String?                     @db.Text
  metadata              Json?
  expectedVersion       Int
  resultingVersion      Int
  createdAt             DateTime                    @default(now()) @db.Timestamptz(3)
  orderFulfilment       OrderFulfilment             @relation(fields: [orderFulfilmentId], references: [id], onDelete: Restrict)
  actor                 User                        @relation("FulfilmentOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  items                 FulfilmentOperationItem[]
  inventoryTransactions InventoryTransaction[]
  consumedAllocations   SerializedAssetAllocation[]
  handoff               FulfilmentHandoff?

  @@index([orderFulfilmentId, createdAt, id])
  @@index([actorUserId, createdAt, id])
}

model FulfilmentOperationItem {
  id                     String                     @id @default(cuid())
  fulfilmentOperationId  String
  orderFulfilmentItemId  String
  preparedDelta          Int                        @default(0)
  checkedOutDelta        Int                        @default(0)
  serializedAllocationId String?
  createdAt              DateTime                   @default(now()) @db.Timestamptz(3)
  fulfilmentOperation    FulfilmentOperation        @relation(fields: [fulfilmentOperationId], references: [id], onDelete: Restrict)
  orderFulfilmentItem    OrderFulfilmentItem        @relation(fields: [orderFulfilmentItemId], references: [id], onDelete: Restrict)
  serializedAllocation   SerializedAssetAllocation? @relation(fields: [serializedAllocationId], references: [id], onDelete: Restrict)

  @@unique([fulfilmentOperationId, orderFulfilmentItemId, serializedAllocationId])
  @@index([orderFulfilmentItemId, createdAt, id])
}

model ActiveRental {
  id                String              @id @default(cuid())
  rentalOrderId     String              @unique
  orderFulfilmentId String              @unique
  status            ActiveRentalStatus
  rentalStartAt     DateTime            @db.Timestamptz(3)
  expectedReturnAt  DateTime            @db.Timestamptz(3)
  checkedOutAt      DateTime            @default(now()) @db.Timestamptz(3)
  activatedByUserId String
  version           Int                 @default(0)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  rentalOrder       RentalOrder         @relation(fields: [rentalOrderId], references: [id], onDelete: Restrict)
  orderFulfilment   OrderFulfilment     @relation(fields: [orderFulfilmentId], references: [id], onDelete: Restrict)
  activatedBy       User                @relation("ActiveRentalActivator", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  items             ActiveRentalItem[]
  handoffs          FulfilmentHandoff[]

  @@index([status, expectedReturnAt, id])
}

model ActiveRentalItem {
  id                    String                        @id @default(cuid())
  activeRentalId        String
  rentalOrderItemId     String                        @unique
  orderFulfilmentItemId String                        @unique
  checkedOutQuantity    Int
  createdAt             DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                      @updatedAt @db.Timestamptz(3)
  activeRental          ActiveRental                  @relation(fields: [activeRentalId], references: [id], onDelete: Restrict)
  rentalOrderItem       RentalOrderItem               @relation(fields: [rentalOrderItemId], references: [id], onDelete: Restrict)
  orderFulfilmentItem   OrderFulfilmentItem           @relation(fields: [orderFulfilmentItemId], references: [id], onDelete: Restrict)
  serializedAssets      ActiveRentalSerializedAsset[]

  @@unique([activeRentalId, rentalOrderItemId])
  @@index([activeRentalId, id])
}

model ActiveRentalSerializedAsset {
  id                     String                    @id @default(cuid())
  activeRentalItemId     String
  serializedAllocationId String                    @unique
  inventoryItemId        String                    @unique
  checkedOutAt           DateTime                  @default(now()) @db.Timestamptz(3)
  createdAt              DateTime                  @default(now()) @db.Timestamptz(3)
  activeRentalItem       ActiveRentalItem          @relation(fields: [activeRentalItemId], references: [id], onDelete: Restrict)
  serializedAllocation   SerializedAssetAllocation @relation(fields: [serializedAllocationId], references: [id], onDelete: Restrict)
  inventoryItem          InventoryItem             @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([activeRentalItemId, id])
}

model FulfilmentHandoff {
  id                       String                @id @default(cuid())
  activeRentalId           String
  fulfilmentOperationId    String                @unique
  type                     FulfilmentHandoffType
  recipientName            String?
  destinationSnapshot      String?               @db.Text
  acknowledgementReference String?
  internalNotes            String?               @db.Text
  actorUserId              String
  handoffAt                DateTime              @db.Timestamptz(3)
  createdAt                DateTime              @default(now()) @db.Timestamptz(3)
  activeRental             ActiveRental          @relation(fields: [activeRentalId], references: [id], onDelete: Restrict)
  fulfilmentOperation      FulfilmentOperation   @relation(fields: [fulfilmentOperationId], references: [id], onDelete: Restrict)
  actor                    User                  @relation("FulfilmentHandoffActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([activeRentalId, handoffAt, id])
  @@index([actorUserId, handoffAt, id])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String   @db.Text
  altText   String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, sortOrder, id])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, sortOrder, id])
}
